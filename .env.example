# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file. It is ignored by .gitignore.

# Supabase configuration (Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Use the Publishable Key (recommended). It is safe for the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Legacy anon key (optional if the publishable key is set)
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY: direct Gemini fallback key.
# Used only when running `npm run dev` (import.meta.env.DEV).
# Production NEVER ships a Gemini key to the browser; all AI calls
# go through the `ai-assistant` Supabase Edge Function, whose key
# is set with: supabase secrets set GOOGLE_API_KEY=...
# ---------------------------------------------------------------
VITE_GEMINI_DEV_KEY=
